# Copy this file to backend/.env and fill in your own values.
# backend/.env is listed in .gitignore and must never be committed.
# On Vercel, the same names are set under Settings > Environment Variables.

# Neon connection string (secret)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Allowed frontend origins, comma-separated, no trailing slash.
# Locally: http://localhost:8080   On Vercel: add the deployed frontend URL too.
CORS_ORIGINS=http://localhost:8080

# Secret used to sign login tokens (secret). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare Turnstile secret key (secret).
# Locally use Cloudflare's public TEST key below (it accepts the test widget's
# dummy token). On Vercel use the real secret key from the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: requests allowed per IP per 15 minutes (defaults: 300 and 20).
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
